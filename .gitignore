# secrets
.env
.env.local
*.key
*.pem
*_token*
passwords.json
secrets.*

# toolchain and build artifacts
toolchain/
build/
out/

# archives, built or hand-made: publishing stops on ANY untracked file in the
# root, and a forgotten .rar next to it once blocked a release
*.rar
*.zip
*.7z
*.o
*.d
*.elf
*.nso
*.npdm
*.nacp
*.lst
*.map

# switch binaries — never commit these
*.ovl
*.nro
*.nsp
*.kip
*.kip1
*.bin
*.dat
payload.bin

# generated package
package/dist/

# temporary
*.bak
*.tmp
*.log
~$*
scratch/

# os / editors
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
